{
  "name": "rec-exam-predictor-root",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n \"backend,frontend\" -c \"blue,green\" \"npm run backend\" \"npm run frontend\"",
    "frontend": "npm --prefix frontend run dev",
    "backend": "cd backend && .venv\\Scripts\\python -m uvicorn app.main:app --reload --port 8000",
    "build": "npm --prefix frontend run build",
    "start": "cd backend && .venv\\Scripts\\python -m uvicorn app.main:app --port 8000"
  },
  "devDependencies": {
    "concurrently": "^10.0.7"
  }
}
